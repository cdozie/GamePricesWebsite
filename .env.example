# Copy to .env, supply fresh values, and export them before starting the app.
# .env is not loaded automatically. See README.md for shell loading instructions.
# Quote values containing shell metacharacters when using the documented loader.
SECRET_KEY=
MAIL_USERNAME=
MAIL_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=main_schema
